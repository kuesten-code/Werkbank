# Küstencode Werkbank - Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.

# ============================================================
# Datenbank
# ============================================================
POSTGRES_PASSWORD=change_me

# ============================================================
# JWT-Authentifizierung
# ============================================================
# Mindestens 32 Zeichen, zufällig generieren:
# openssl rand -base64 32
JWT_SECRET=change_me_use_a_long_random_string_here

# ============================================================
# Port (nach außen)
# ============================================================
# Anpassen wenn Port 8080 auf dem Host bereits belegt ist.
HOST_PORT=8080

# ============================================================
# Docker-Gruppe (für die Docker-Steuerung aus dem Host)
# ============================================================
# Gruppen-ID, der der Docker-Socket gehört. Wird von ./setup.sh (bzw. setup.ps1) automatisch
# eingetragen, wenn der Wert leer bleibt. Manuell ermitteln (Linux):
#   stat -c %g /var/run/docker.sock
# Docker Desktop (Windows/macOS): 0
DOCKER_GID=

# ============================================================
# Docker Zugangsdaten
# ============================================================
# Anpassen wenn automatische Updates über Watchtower gewünscht sind.
DOCKER_PAT=XXX
DOCKER_USER=XXX