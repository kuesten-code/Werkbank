@page "/kosten"
@inherits LocatioKomponente
@inject IKostenService KostenService
@inject IKategorieService KategorieService
@inject IGebaeudeService GebaeudeService
@inject IAfaService AfaService

<PageTitle>Locatio – Kosten</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4">Kosten</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudSelect T="int" Value="_jahr" ValueChanged="JahrGeaendertAsync" Label="Jahr" Dense="true" Variant="Variant.Outlined" Style="width:120px">
                @foreach (var jahr in Enumerable.Range(DateTime.Today.Year - 5, 6).Reverse())
                {
                    <MudSelectItem T="int" Value="jahr">@jahr</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => ErfassenAsync(null)">Kosten erfassen</MudButton>
        </MudStack>
    </MudStack>

    <MudPaper Class="pa-2 mb-4" Elevation="1">
        <KostenTabelle Kosten="_kosten" Bearbeiten="ErfassenAsync" Loeschen="LoeschenAsync" />
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">Abschreibung (AfA) @_jahr</MudText>
    <MudPaper Class="pa-2" Elevation="1">
        <MudTable T="AfaVorschlagDto" Items="_afa" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>Gebäude</MudTh>
                <MudTh>Einheit</MudTh>
                <MudTh Style="text-align:right">AfA-Basis</MudTh>
                <MudTh Style="text-align:right">Satz</MudTh>
                <MudTh Style="text-align:right">Monate</MudTh>
                <MudTh Style="text-align:right">Betrag</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Gebaeude</MudTd>
                <MudTd>@context.Einheit@(context.AusGebaeude ? " (anteilig)" : "")</MudTd>
                <MudTd Style="text-align:right">@Euro(context.AfaBasis)</MudTd>
                <MudTd Style="text-align:right">@context.AfaSatz.ToString("0.##") %</MudTd>
                <MudTd Style="text-align:right">@context.Monate</MudTd>
                <MudTd Style="text-align:right">@Euro(context.Betrag)</MudTd>
                <MudTd Style="text-align:right">
                    @if (context.BereitsGebucht)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">gebucht</MudChip>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => AfaBuchenAsync(context)">Buchen</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Color="Color.Secondary">Keine Einheit mit AfA-Grundlage für @_jahr (Anschaffungsdaten an Einheit oder Gebäude, bei Gebäuden mit Fläche je Einheit).</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<Kostenposten> _kosten = new();
    private List<AfaVorschlagDto> _afa = new();
    private int _jahr = DateTime.Today.Year;

    protected override Task OnInitializedAsync() => LadeAsync();

    private async Task LadeAsync()
    {
        _kosten = await KostenService.GetAsync(_jahr);
        _afa = await AfaService.GetVorschlaegeAsync(_jahr);
    }

    private async Task JahrGeaendertAsync(int jahr)
    {
        _jahr = jahr;
        await LadeAsync();
    }

    private async Task ErfassenAsync(Kostenposten? posten)
    {
        var gebaeude = (await GebaeudeService.GetAllAsync()).Where(g => !g.VerkaufsDatum.HasValue || g.Id == posten?.GebaeudeId).ToList();
        var erfassung = await ZeigeDialogAsync<KostenDialog, ErfassungMitDatei<Kostenposten>>(posten == null ? "Kosten erfassen" : "Kosten bearbeiten", new()
        {
            { x => x.Posten, posten ?? new Kostenposten { GebaeudeId = gebaeude.FirstOrDefault()?.Id } },
            { x => x.Gebaeude, gebaeude },
            { x => x.Kategorien, await KategorieService.GetAusgabekategorienAsync() }
        });
        if (erfassung != null)
            await VersucheAsync(() => KostenService.SaveAsync(erfassung.Eintrag, erfassung.Datei), "Kosten gespeichert.");
        await LadeAsync();
    }

    private async Task LoeschenAsync(Kostenposten posten)
    {
        if (!await BestaetigeAsync($"Kostenposten \"{posten.Beschreibung}\" löschen?"))
            return;
        await VersucheAsync(() => KostenService.DeleteAsync(posten.Id), "Kostenposten gelöscht.");
        await LadeAsync();
    }

    private async Task AfaBuchenAsync(AfaVorschlagDto vorschlag)
    {
        await VersucheAsync(() => AfaService.BucheAsync(vorschlag.MieteinheitId, _jahr), $"AfA {vorschlag.Einheit} gebucht.");
        await LadeAsync();
    }
}
